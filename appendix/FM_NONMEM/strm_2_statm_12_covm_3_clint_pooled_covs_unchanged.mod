$PROBLEM
$INPUT ID AMT TIME ADDL II EVID CMT STUD MDV TAD DOSE DV AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN CLCR BMI HISP WHITE AFRAMER ASIAN SEX OBESE
$DATA strm_2_statm_12_covm_3_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
ETA_V2=ETA(1)
ETA_CL=ETA(2)
ETA_KA=ETA(3)
CLCR_MEDIAN = 75.7365084302190
BILIRUBIN_MEDIAN = 0.500000000000000
TVCL = THETA(5)
CL = TVCL*EXP(ETA_CL)
CLBILIRUBIN = EXP(THETA(6)*(BILIRUBIN - BILIRUBIN_MEDIAN))
CLCLCR = EXP(THETA(7)*(CLCR - CLCR_MEDIAN))
CL = CL*CLBILIRUBIN*CLCLCR
TVKA = THETA(4)
KA = TVKA*EXP(ETA_KA)
TVQ = THETA(3)
Q = TVQ
TVV3 = THETA(2)
V3 = TVV3
TVV2 = THETA(1)
V2 = TVV2*EXP(ETA_V2)
$ERROR
IPRED = A(2)/V2
IF (IPRED.EQ.0) THEN
    IPREDADJ = 7.32187750388909E-5
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V2
$THETA  (0,1900.0) ; POP_V3
$THETA  (0,22.9) ; POP_Q
$THETA  (0,0.75) ; POP_KA
$THETA  (0,19.2) ; POP_CL
$THETA  (-0.7143,0.2915,0.7143) ; POP_CLBILIRUBIN
$THETA  (-0.0073,0.0025,0.0073) ; POP_CLCLCR
$OMEGA BLOCK(2)
0.1844027229977793	; IIV_V2
0.0829812253490007	; IIV_CL_IIV_V2
0.1844027229977793	; IIV_CL
$OMEGA  0.1844027229977793 ; IIV_KA
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V2 ETA_CL ETA_KA IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
