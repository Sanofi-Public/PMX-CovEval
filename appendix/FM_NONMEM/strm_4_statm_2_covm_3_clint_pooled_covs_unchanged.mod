$PROBLEM
$INPUT AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN HISP WHITE AFRAMER ASIAN SEX CLCR BMI OBESE ID AMT TIME ADDL II EVID CMT STUD MDV DV
$DATA strm_4_statm_2_covm_3_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=9
$MODEL COMPARTMENT=(DEPOT DEFDOSE) COMPARTMENT=(CENTRAL) COMPARTMENT=(PERIPHERAL1)
$PK
ETA_V1=ETA(1)
ETA_KA=ETA(2)
ETA_CL=ETA(3)
BILIRUBIN_MEDIAN = 0.500000000000000
CLCR_MEDIAN = 125.418724279835
TVKM = THETA(7)
KM = TVKM
TVVMAX = THETA(6)
VMAX = TVVMAX
TVCL = THETA(5)
CL = TVCL*EXP(ETA_CL)
CLCLCR = EXP(THETA(8)*(CLCR - CLCR_MEDIAN))
CLBILIRUBIN = EXP(THETA(9)*(BILIRUBIN - BILIRUBIN_MEDIAN))
CL = CL*CLBILIRUBIN*CLCLCR
TVKA = THETA(4)
KA = TVKA*EXP(ETA_KA)
TVQ = THETA(3)
Q = TVQ
TVV2 = THETA(2)
V2 = TVV2
TVV1 = THETA(1)
V1 = TVV1*EXP(ETA_V1)
$DES
DADT(1) = -A(1)*KA
DADT(2) = A(1)*KA + A(2)*(-CL/V1 - Q/V1 - VMAX/(V1*(A(2)/V1 + KM))) + A(3)*Q/V2
DADT(3) = A(2)*Q/V1 - A(3)*Q/V2
$ERROR
IPRED = A(2)/V1
IF (IPRED.EQ.0) THEN
    IPREDADJ = 9.55627033252255E-5
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V1
$THETA  (0,1900.0) ; POP_V2
$THETA  (0,22.9) ; POP_Q
$THETA  (0,0.75) ; POP_KA
$THETA  (0,9.6) ; POP_CL
$THETA  (0,9.6) ; POP_VMAX
$THETA  (0,0.4) ; POP_KM
$THETA  (-0.0089,0.0021,0.0089) ; POP_CLCLCR
$THETA  (-0.7143,0.2915,0.7143) ; POP_CLBILIRUBIN
$OMEGA  0.1844027229977793 ; IIV_V1
$OMEGA  0.1844027229977793 ; IIV_KA
$OMEGA  0.1844027229977793 ; IIV_CL
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V1 ETA_KA ETA_CL IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
