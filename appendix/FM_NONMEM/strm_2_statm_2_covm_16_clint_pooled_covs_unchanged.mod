$PROBLEM
$INPUT AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN HISP WHITE AFRAMER ASIAN SEX CLCR BMI OBESE ID AMT TIME ADDL II EVID CMT STUD MDV DV
$DATA strm_2_statm_2_covm_16_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
ETA_V2=ETA(1)
ETA_KA=ETA(2)
ETA_CL=ETA(3)
TVCL = THETA(5)
CL = TVCL*EXP(ETA_CL)
IF (OBESE.EQ.0) THEN
    CLOBESE = 1
ELSE IF (OBESE.EQ.1.0) THEN
    CLOBESE = THETA(6) + 1
END IF
IF (AFRAMER.EQ.0) THEN
    CLAFRAMER = 1
ELSE IF (AFRAMER.EQ.1.0) THEN
    CLAFRAMER = THETA(7) + 1
END IF
IF (SEX.EQ.2.0) THEN
    CLSEX = 1
ELSE IF (SEX.EQ.1.0) THEN
    CLSEX = THETA(8) + 1
END IF
CL = CL*CLAFRAMER*CLOBESE*CLSEX
TVKA = THETA(4)
KA = TVKA*EXP(ETA_KA)
TVQ = THETA(3)
Q = TVQ
TVV3 = THETA(2)
V3 = TVV3
TVV2 = THETA(1)
V2 = TVV2*EXP(ETA_V2)
$ERROR
IPRED = A(2)/V2
IF (IPRED.EQ.0) THEN
    IPREDADJ = 8.86318923341432E-5
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V2
$THETA  (0,1900.0) ; POP_V3
$THETA  (0,22.9) ; POP_Q
$THETA  (0,0.75) ; POP_KA
$THETA  (0,19.2) ; POP_CL
$THETA  (-1,0.19999999999999996,5) ; POP_CLOBESE
$THETA  (-1,0.19999999999999996,5) ; POP_CLAFRAMER
$THETA  (-1,0.19999999999999996,5) ; POP_CLSEX
$OMEGA  0.1844027229977793 ; IIV_V2
$OMEGA  0.1844027229977793 ; IIV_KA
$OMEGA  0.1844027229977793 ; IIV_CL
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V2 ETA_KA ETA_CL IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
