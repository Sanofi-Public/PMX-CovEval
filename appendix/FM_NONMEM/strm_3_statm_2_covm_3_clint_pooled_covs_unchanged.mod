$PROBLEM
$INPUT ID AMT TIME ADDL II EVID CMT STUD MDV TAD DOSE DV AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN CLCR BMI HISP WHITE AFRAMER ASIAN SEX OBESE
$DATA strm_3_statm_2_covm_3_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=9
$MODEL COMPARTMENT=(DEPOT DEFDOSE) COMPARTMENT=(CENTRAL) COMPARTMENT=(PERIPHERAL1)
$PK
ETA_V1=ETA(1)
ETA_KA=ETA(2)
ETA_VMAX=ETA(3)
CLCR_MEDIAN = 75.7365084302190
BILIRUBIN_MEDIAN = 0.500000000000000
TVKM = THETA(6)
KM = TVKM
TVVMAX = THETA(5)
VMAX = TVVMAX*EXP(ETA_VMAX)
VMAXBILIRUBIN = EXP(THETA(7)*(BILIRUBIN - BILIRUBIN_MEDIAN))
VMAXCLCR = EXP(THETA(8)*(CLCR - CLCR_MEDIAN))
VMAX = VMAX*VMAXBILIRUBIN*VMAXCLCR
TVKA = THETA(4)
KA = TVKA*EXP(ETA_KA)
TVQ = THETA(3)
Q = TVQ
TVV2 = THETA(2)
V2 = TVV2
TVV1 = THETA(1)
V1 = TVV1*EXP(ETA_V1)
$DES
DADT(1) = -A(1)*KA
DADT(2) = A(1)*KA + A(2)*(-Q/V1 - VMAX/(V1*(A(2)/V1 + KM))) + A(3)*Q/V2
DADT(3) = A(2)*Q/V1 - A(3)*Q/V2
$ERROR
IPRED = A(2)/V1
IF (IPRED.EQ.0) THEN
    IPREDADJ = 9.89028121351424E-5
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V1
$THETA  (0,1900.0) ; POP_V2
$THETA  (0,22.9) ; POP_Q
$THETA  (0,0.75) ; POP_KA
$THETA  (0,50.0) ; POP_VMAX
$THETA  (0,2.6) ; POP_KM
$THETA  (-0.7143,0.2915,0.7143) ; POP_VMAXBILIRUBIN
$THETA  (-0.0073,0.0025,0.0073) ; POP_VMAXCLCR
$OMEGA  0.1844027229977793 ; IIV_V1
$OMEGA  0.1844027229977793 ; IIV_KA
$OMEGA  0.1844027229977793 ; IIV_VMAX
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V1 ETA_KA ETA_VMAX IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
