$PROBLEM
$INPUT AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN HISP WHITE AFRAMER ASIAN SEX CLCR BMI OBESE ID AMT TIME ADDL II EVID CMT STUD MDV DV
$DATA strm_1_statm_2_covm_3_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN2 TRANS2
$PK
ETA_V=ETA(1)
ETA_KA=ETA(2)
ETA_CL=ETA(3)
BILIRUBIN_MEDIAN = 0.500000000000000
CLCR_MEDIAN = 125.418724279835
TVCL = THETA(3)
CL = TVCL*EXP(ETA_CL)
CLCLCR = EXP(THETA(4)*(CLCR - CLCR_MEDIAN))
CLBILIRUBIN = EXP(THETA(5)*(BILIRUBIN - BILIRUBIN_MEDIAN))
CL = CL*CLBILIRUBIN*CLCLCR
TVKA = THETA(2)
KA = TVKA*EXP(ETA_KA)
TVV = THETA(1)
V = TVV*EXP(ETA_V)
$ERROR
IPRED = A(2)/V
IF (IPRED.EQ.0) THEN
    IPREDADJ = 9.25032212464097E-12
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V
$THETA  (0,0.75) ; POP_KA
$THETA  (0,19.2) ; POP_CL
$THETA  (-0.0089,0.0021,0.0089) ; POP_CLCLCR
$THETA  (-0.7143,0.2915,0.7143) ; POP_CLBILIRUBIN
$OMEGA  0.1844027229977793 ; IIV_V
$OMEGA  0.1844027229977793 ; IIV_KA
$OMEGA  0.1844027229977793 ; IIV_CL
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V ETA_KA ETA_CL IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
