$PROBLEM
$INPUT ID AMT TIME ADDL II EVID CMT STUD MDV TAD DOSE DV AGE WEIGHT HEIGHT FAT SCR ALT AST ALP ALBUMIN BILIRUBIN CLCR BMI HISP WHITE AFRAMER ASIAN SEX OBESE
$DATA strm_2_statm_2_covm_31_clint_pooled_covs_unchanged_table.csv IGNORE=@
$SUBROUTINES ADVAN4 TRANS4
$PK
ETA_V2=ETA(1)
ETA_KA=ETA(2)
ETA_CL=ETA(3)
AGE_MEDIAN = 35.0000000000000
WEIGHT_MEDIAN = 75.9000000000000
CLCR_MEDIAN = 75.7365084302190
TVCL = THETA(5)
CL = TVCL*EXP(ETA_CL)
CLCLCR = EXP(THETA(6)*(CLCR - CLCR_MEDIAN))
CL = CL*CLCLCR
TVKA = THETA(4)
KA = TVKA*EXP(ETA_KA)
KAAGE = EXP(THETA(8)*(AGE - AGE_MEDIAN))
KA = KA*KAAGE
TVQ = THETA(3)
Q = TVQ
TVV3 = THETA(2)
V3 = TVV3
TVV2 = THETA(1)
V2 = TVV2*EXP(ETA_V2)
V2WEIGHT = EXP(THETA(7)*(WEIGHT - WEIGHT_MEDIAN))
V2 = V2*V2WEIGHT
$ERROR
IPRED = A(2)/V2
IF (IPRED.EQ.0) THEN
    IPREDADJ = 5.23761813818927E-5
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ
$THETA  (0,628.0) ; POP_V2
$THETA  (0,1900.0) ; POP_V3
$THETA  (0,22.9) ; POP_Q
$THETA  (0,0.75) ; POP_KA
$THETA  (0,19.2) ; POP_CL
$THETA  (-0.0073,0.0038,0.0073) ; POP_CLCLCR
$THETA  (-0.0184,0.0058,0.0184) ; POP_V2WEIGHT
$THETA  (-0.0833,0.011,0.0833) ; POP_KAAGE
$OMEGA  0.1844027229977793 ; IIV_V2
$OMEGA  0.1844027229977793 ; IIV_KA
$OMEGA  0.1844027229977793 ; IIV_CL
$SIGMA  0.04 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=99999 SIGDIGITS = 3
$COVARIANCE MATRIX=R UNCONDITIONAL PRINT=E PRECOND=1
$TABLE ID TIME DV CIPREDI PRED CWRES ETA_V2 ETA_KA ETA_CL IPRED FILE=mytab ONEHEADER NOAPPEND NOPRINT
