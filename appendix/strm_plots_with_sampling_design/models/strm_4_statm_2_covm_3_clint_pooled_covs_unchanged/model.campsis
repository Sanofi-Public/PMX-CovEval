[MAIN]
median_BILIRUBIN=0.5
median_CLCR=75.736508430219
TVBIO=THETA_BIO
TVKA=THETA_KA
TVVC=THETA_VC
TVVP=THETA_VP
TVQ=THETA_Q
TVCL=THETA_CL
TVVMAX=THETA_VMAX
TVKM=THETA_KM

CL_CLCR=exp(THETA_POP_CL_CLCR*(CLCR-75.736508430219))
CL_BILIRUBIN=exp(THETA_POP_CL_BILIRUBIN*(BILIRUBIN-0.5))
BIO=TVBIO
KA=TVKA * exp(ETA_KA)
VC=TVVC * exp(ETA_VC)
VP=TVVP * exp(ETA_VP)
Q=TVQ
CL=TVCL * exp(ETA_CL)*CL_CLCR*CL_BILIRUBIN
VMAX=TVVMAX
KM=TVKM

[ODE]
d/dt(A_ABS)=-KA*A_ABS
d/dt(A_CENTRAL)=KA*A_ABS + Q/VP*A_PERIPHERAL - Q/VC*A_CENTRAL - (VMAX/VC*A_CENTRAL/(A_CENTRAL/VC+KM) + CL/VC*A_CENTRAL)
d/dt(A_PERIPHERAL)=Q/VC*A_CENTRAL - Q/VP*A_PERIPHERAL

[F]
A_ABS=BIO

[INIT]
A_CENTRAL=0

[ERROR]
CONC=A_CENTRAL/VC
if (CONC <= 0.000000001) CONC=0.000000001
CONC_ERR=CONC*(1 + EPS_PROP_RUV)
Q_ind=Q
VP_ind=VP
CL_ind=CL
VC_ind=VC
KA_ind=KA

