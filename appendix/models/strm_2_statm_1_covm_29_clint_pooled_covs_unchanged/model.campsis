[MAIN]
median_BMI=27.5201430076628
median_AGE=36
median_ALBUMIN=4.3
median_WEIGHT=77.8
median_BILIRUBIN=0.5
median_CLCR=125.415811965812
TVBIO=THETA_BIO
TVKA=THETA_KA
TVVC=THETA_VC
TVVP=THETA_VP
TVQ=THETA_Q
TVCL=THETA_CL

CL_CLCR=exp(THETA_POP_CL_CLCR*(CLCR-125.415811965812))
CL_BILIRUBIN=exp(THETA_POP_CL_BILIRUBIN*(BILIRUBIN-0.5))
VC_WEIGHT=exp(THETA_POP_VC_WEIGHT*(WEIGHT-77.8))
VC_ALBUMIN=exp(THETA_POP_VC_ALBUMIN*(ALBUMIN-4.3))
KA_AGE=exp(THETA_POP_KA_AGE*(AGE-36))
KA_BMI=exp(THETA_POP_KA_BMI*(BMI-27.5201430076628))
BIO=TVBIO
KA=TVKA * exp(ETA_KA)*KA_AGE*KA_BMI
VC=TVVC * exp(ETA_VC)*VC_WEIGHT*VC_ALBUMIN
VP=TVVP * exp(ETA_VP)
Q=TVQ
CL=TVCL * exp(ETA_CL)*CL_CLCR*CL_BILIRUBIN

[ODE]
d/dt(A_ABS)=-KA*A_ABS
d/dt(A_CENTRAL)=KA*A_ABS + Q/VP*A_PERIPHERAL - Q/VC*A_CENTRAL - CL/VC*A_CENTRAL
d/dt(A_PERIPHERAL)=Q/VC*A_CENTRAL - Q/VP*A_PERIPHERAL

[F]
A_ABS=BIO

[INIT]
A_CENTRAL=0

[ERROR]
CONC=A_CENTRAL/VC
if (CONC <= 0.000000001) CONC=0.000000001
CONC_ERR=CONC*(1 + EPS_PROP_RUV)
Q_ind=Q
VP_ind=VP
CL_ind=CL
VC_ind=VC
KA_ind=KA

